{
	"name": "@blackscaletech/n8n-nodes-swarm",
	"version": "0.1.0",
	"description": "Connect n8n workflows and AI agents to shared knowledge, Tasks, Artifacts and work in Swarm Spaces.",
	"license": "MIT",
	"homepage": "https://swarm.services",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Blackscale",
		"email": "hello@blackscale.tech",
		"url": "https://blackscale.tech"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/blackscaletech/swarm-n8n.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev --external-n8n --custom-user-folder .local/dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"scan": "npm run build && node scripts/scan.mjs",
		"audit:dependencies": "npm audit --audit-level=moderate",
		"review:dependencies": "node scripts/review-dependencies.mjs",
		"test": "npm run build && node --test test/*.test.mjs",
		"test:integration": "node test/acceptance.mjs",
		"verify": "npm run lint && npm test && node scripts/check-package.mjs",
		"prepublishOnly": "npm run review:dependencies && npm run verify && npm run scan"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SwarmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Swarm/Swarm.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.3",
		"@n8n/scan-community-package": "0.41.0",
		"eslint": "10.13.0",
		"n8n-workflow": "2.45.1",
		"prettier": "3.8.3",
		"typescript": "6.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=24.22.1"
	},
	"packageManager": "npm@11.19.1",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
